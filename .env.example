# انسخ الملف ده لـ .env وغيّر القيم.
# ملف .env لا يُرفع للريبو أبدًا.

# ---- General ----
ENVIRONMENT=local          # local | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ---- PostgreSQL ----
POSTGRES_USER=fitflow
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=fitflow
# localhost للتشغيل المباشر على الجهاز.
# مع Docker يتجاوزه ملف compose ويضبطه على اسم الخدمة تلقائيًا.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Backend ----
BACKEND_PORT=8000
# مفتاح توقيع الـ JWT. للإنتاج: openssl rand -hex 32
SECRET_KEY=dev_only_secret_change_me_in_production_0000000000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# مصادر مسموح لها بالوصول (مفصولة بفاصلة)
CORS_ORIGINS=http://localhost:3000

# ---- أول حساب مدير (يُنشئه `make seed`) ----
# ⚠️ غيّر كلمة السر دي قبل أي نشر — السكربت يرفض القيمة الافتراضية في الإنتاج.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe_Admin_2026!
FIRST_ADMIN_NAME=مدير النظام

# ---- Frontend ----
FRONTEND_PORT=3000
# الواجهة تنادي الـ API من الخادم فقط (الجلسة في كوكي httpOnly)، فهذا
# هو العنوان الذي تستخدمه فعليًا. مع Docker يضبطه ملف compose على
# http://backend:8000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- AI (المرحلة 6 — اتركه فاضي دلوقتي) ----
ANTHROPIC_API_KEY=

# ---- المرفقات الطبية ----
# مسار نسبي يُحلّ من مجلد backend/. لا ترفع محتواه للريبو.
# مع Docker يُربط بـ volume مسمّى اسمه uploads.
UPLOAD_DIR=var/uploads
MAX_UPLOAD_MB=10

# ---- Object storage (بديل التخزين المحلي عند النشر) ----
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
