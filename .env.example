# انسخ الملف ده لـ .env وغيّر القيم.
# ملف .env لا يُرفع للريبو أبدًا.

# ---- General ----
ENVIRONMENT=local          # local | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ---- PostgreSQL ----
POSTGRES_USER=fitflow
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=fitflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Backend ----
BACKEND_PORT=8000
# مفتاح توقيع الـ JWT. للإنتاج: openssl rand -hex 32
SECRET_KEY=dev_only_secret_change_me_in_production_0000000000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# مصادر مسموح لها بالوصول (مفصولة بفاصلة)
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- AI (المرحلة 6 — اتركه فاضي دلوقتي) ----
ANTHROPIC_API_KEY=

# ---- Object storage (المرحلة 5 — اتركه فاضي دلوقتي) ----
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
